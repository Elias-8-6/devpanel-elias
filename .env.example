# Copy to .env:  cp .env.example .env
# Values below are for LOCAL DEVELOPMENT ONLY. Never reuse them anywhere else.

NODE_ENV=development
PORT=3000
# Host port where docker-compose publishes the API (change it if 3000 is taken)
BACKEND_HOST_PORT=3000

# PostgreSQL (docker-compose overrides DB_HOST to "db" inside the network)
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=devpanel
POSTGRES_PASSWORD=devpanel_local_pw
POSTGRES_DB=devpanel
# Auto-create tables from entities. Development only.
DB_SYNCHRONIZE=true

# Auth: secret must be >= 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=dev-only-change-me-0123456789abcdefghijklmnopqrstuvwxyz
JWT_EXPIRES_IN=30m

# Test admin created by the seed when the users table is empty (not in production)
SEED_ADMIN_EMAIL=admin@devpanel.local
SEED_ADMIN_PASSWORD=DevPanel#2026

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Global rate limit (per IP): THROTTLE_LIMIT requests every THROTTLE_TTL_MS
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
